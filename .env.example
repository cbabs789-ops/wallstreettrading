# Copy to .env and fill in. .env is git-ignored. Never paste these values into a chat.

# Required by the SEC on every request: a name and a contact email.
PWS_SEC_USER_AGENT="Your Name you@example.com"

# Optional: where the database and logs live (default ./var)
# PWS_DATA_DIR=/path/to/data

# Paper account
# PWS_PAPER_CASH=10000
# PWS_SLIPPAGE_BPS=5
# PWS_FRACTIONAL=1

# Risk limits (defaults shown)
# PWS_MAX_POSITION_PCT=10
# PWS_MAX_LOSS_PER_TRADE_PCT=1
# PWS_MAX_OPEN_POSITIONS=10
# PWS_DAILY_LOSS_LIMIT_PCT=3
# PWS_MAX_DRAWDOWN_PCT=15
# PWS_MAX_SECTOR_PCT=35
# PWS_MAX_CORRELATION=0.85

# Universe override (comma separated)
# PWS_UNIVERSE=SPY,QQQ,AAPL,MSFT

# Schwab (read-only market data and account view). Leave blank until your developer app is approved.
# SCHWAB_APP_KEY=
# SCHWAB_APP_SECRET=
# SCHWAB_CALLBACK_URL=https://127.0.0.1
